# Environment for `docker compose up`.
# The database host is the Compose service name. The host `.env` stays for
# `cargo run` and uses localhost.

POSTGRES_USER=margin
POSTGRES_PASSWORD=margin
POSTGRES_DB=margin_engine
DATABASE_URL=postgres://margin:margin@postgres:5432/margin_engine
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,sqlx=warn
MARGIN_LOG_FORMAT=json
